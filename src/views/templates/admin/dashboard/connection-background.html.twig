{#
 # The Background tasks card (ARCHITECTURE 4.3): when the last tick ran and from where, and, while
 # the tasks do not run from a cron URL every minute, what to do. An admin who may change the
 # settings then sees the store's one cron line in the card, and in the running state gets it on
 # "Show the cron line"; either way the page asks the server for it (dashboard.js) and never
 # carries the token itself. Another admin reads whom to ask. The button stands below the status
 # pill with a one-line reason beside it (owner, 2026-11-26; Linear CON-460); the Initial setup's
 # Overview draws the same box (setup/overview.html.twig).
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% if smaily_dashboard is defined %}
  {% set card = smaily_dashboard.connections.background %}
  <div id="smaily-background" class="smaily-background">
    {% include '@Modules/smailyforprestashop/views/templates/admin/dashboard/card.html.twig' with {card: card} only %}
    {% if card.hint %}
      <p class="smaily-connection__hint">{{ card.hint }}</p>
    {% endif %}
    {% if card.cron_button %}
      <div data-smaily-cron-line="{{ path('smailyforprestashop_api_cron_line') }}"{% if card.cron_open %} data-smaily-cron-open{% endif %}>
        <div class="smaily-cron-ask" data-smaily-cron-ask{% if card.cron_open %} hidden{% endif %}>
          <button type="button" class="btn btn-outline-secondary btn-sm" data-smaily-action="cron-line">{{ 'Show the cron line'|trans }}</button>
          <span class="smaily-note">{{ 'Add it to your server\'s cron for reliable timing.'|trans }}</span>
        </div>
        <code class="smaily-cron" data-smaily-cron hidden></code>
        <div class="smaily-result" data-smaily-result role="status"></div>
      </div>
    {% endif %}
    {% if card.ask_admin %}
      <p class="smaily-connection__hint">{{ card.ask_admin }}</p>
    {% endif %}
  </div>
{% endif %}
