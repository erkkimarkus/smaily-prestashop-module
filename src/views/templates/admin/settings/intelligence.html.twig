{#
 # Settings > Intelligence (Magento's Intelligence tab): the Intelligence panel with the
 # recommendations card, the import cards and Save. The tab has no switch "Use its own … on this
 # shop": one store has one connection for every shop, and separate stores connect each shop on
 # its own. In separate stores with "All shops" selected, the tab says to pick a shop.
 #
 # `smaily_settings` comes from Admin\Settings\SettingsController.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% if smaily_settings.intelligence is null %}
  <div class="smaily-panel">
    {% include '@Modules/smailyforprestashop/views/templates/admin/panel/separate-stores.html.twig' only %}
  </div>
{% else %}
  {% include '@Modules/smailyforprestashop/views/templates/admin/panel/intelligence.html.twig' with {
    intelligence: smaily_settings.intelligence,
    context: 'settings',
    shops: smaily_settings.intelligence_shops,
  } only %}
{% endif %}
