{#
 # Settings > Connection (Magento's Connection tab): the invitation while no Smaily account is
 # connected, the switch "Use its own Smaily account on this shop" for a shop selected in one store,
 # the Connection panel of the Initial setup, and Save Connection. The connection's state shows
 # under the account once Smaily has answered (settings.js). In separate stores with "All shops"
 # selected, the tab says to pick a shop instead.
 #
 # `smaily_settings` comes from Admin\Settings\SettingsController.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% set s = smaily_settings %}
{% if s.connection is null %}
  <div class="smaily-panel">
    {% include '@Modules/smailyforprestashop/views/templates/admin/panel/separate-stores.html.twig' only %}
  </div>
{% else %}
  {% if s.invitation %}
    {% include '@Modules/smailyforprestashop/views/templates/admin/layout/invitation.html.twig' with {dismissible: false} %}
  {% endif %}
  {% if s.own is not null %}
    {% include '@Modules/smailyforprestashop/views/templates/admin/settings/own-toggle.html.twig' with {section: 'connection', label: 'Use its own Smaily account on this shop'|trans, own: s.own.connection} only %}
  {% endif %}
  <div class="smaily-own-region" data-smaily-own-region="connection">
    {% include '@Modules/smailyforprestashop/views/templates/admin/panel/connection.html.twig' with {
      connection: s.connection,
      languages: s.languages,
      language_modes: s.language_modes,
      account_per_language_elsewhere: s.account_per_language_elsewhere,
    } only %}
  </div>
  <div class="smaily-tab-footer">
    <button type="button" class="btn smaily-btn-primary" data-smaily-action="save-tab" data-tab="connection">{{ 'Save Connection'|trans }}</button>
    <span class="smaily-result" data-smaily-tab-result role="status"></span>
  </div>
{% endif %}
