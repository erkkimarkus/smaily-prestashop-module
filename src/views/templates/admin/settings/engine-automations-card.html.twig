{#
 # The content of the card "Campaign Intelligence Automations" (Magento's
 # config/engine-automations.phtml), as Campaign Intelligence answers at this moment:
 #
 # - not connected: connect Campaign Intelligence first;
 # - the account is not active: nothing is read or saved;
 # - the list could not be loaded: nothing is listed, so nothing can be saved;
 # - else one row per automation that Campaign Intelligence offers the store now: its name, the
 #   pill Off, Test mode or Active, its description and Enabled; while it is on, also its Test mode
 #   switch, the Smaily workflow it starts, Cooldown, Daily Cap and Test Emails. A row that is off
 #   keeps its values in the form, and the save posts every field of every row.
 #
 # Test mode (CON-459, as WooCommerce's CON-455 and Magento's CON-458) shows for an email that
 # Campaign Intelligence reports a state for (contract §12 `setup[]`), and is on in every state but
 # live. It is no form field: views/js/admin/engine-automations.js calls Campaign Intelligence at
 # once (§20), turning it off only after the dialog "Turn off test mode?", which names the email.
 # While it is on, "Send test email" sends one test email (§19) to an address that starts as the
 # employee's own (`admin_email`). `row.setup` is the email's state in the admin's words
 # (Admin\Settings\EngineAutomationsPanel): the switch, the state line and the notice.
 #
 # `row.name` and `row.description` are Campaign Intelligence's own text (contract §11), the one
 # text of the engine that a screen shows; Twig escapes it as any other value. A row carries the
 # `language_mode` and the workflow map it was drawn with, which the save hands back, so that a
 # per-language setup of another connector stays (Engine\Automations\ConfigRow). `card.account`
 # names the connection's Smaily account where it is not the shop's own, whose workflows are listed.
 #
 # Takes `card` (Admin\Settings\EngineAutomationsPanel::card()) and `admin_email`.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% if card.state == 'not_connected' %}
  <div class="smaily-engine-empty">
    <div class="smaily-engine-empty__icon" aria-hidden="true">i</div>
    <div class="smaily-engine-empty__title">{{ 'Connect Campaign Intelligence to set up these automations'|trans }}</div>
    <div class="smaily-note">{{ 'These engine-run automations (replenishment reminders, win-back and more) become available once Campaign Intelligence is connected.'|trans }}</div>
  </div>
{% elseif card.state == 'refused' %}
  <div class="smaily-banner smaily-banner--danger" role="alert">
    <span class="smaily-banner__icon" aria-hidden="true">&#9888;</span>
    <div class="smaily-banner__body">
      <div class="smaily-banner__title">{{ 'Your Campaign Intelligence account is not active'|trans }}</div>
      <div class="smaily-banner__message">{{ 'Your Campaign Intelligence account is not active, so its automations cannot be read or saved. Once Smaily tells you the account is active, press Check again under Settings > Intelligence.'|trans }}</div>
    </div>
  </div>
{% elseif card.state == 'unavailable' %}
  <div class="smaily-banner" role="status">
    <span class="smaily-banner__icon" aria-hidden="true">&#9888;</span>
    <div class="smaily-banner__body">
      <div class="smaily-banner__title">{{ 'Could not load the automation catalog'|trans }}</div>
      <div class="smaily-banner__message">{{ '%reason% Your saved automations are unchanged.'|trans({'%reason%': card.reason}) }}</div>
    </div>
  </div>
{% else %}
  <p class="smaily-note">{{ 'These automations run inside the Campaign Intelligence engine and fire the mapped Smaily workflow. Every trigger starts disabled and in test mode — nothing reaches real customers without your explicit action.'|trans }}</p>
  {% if card.account != '' %}
    <p class="smaily-note">{{ 'The workflows listed are those of the Smaily account "%account%", which this Campaign Intelligence connection belongs to.'|trans({'%account%': card.account}) }}</p>
  {% endif %}
  {% if card.workflow_error != '' %}
    <p class="smaily-note smaily-note--strong" data-smaily-engine-workflow-error>{{ card.workflow_error }}</p>
  {% endif %}
  {% if card.rows is empty %}
    <p class="smaily-note">{{ 'No engine automations are available for your store yet. New triggers appear here automatically when the engine adds them.'|trans }}</p>
  {% else %}
    {% set offered = card.workflows|map(workflow => workflow.id ~ '') %}
    <div class="smaily-banner smaily-banner--danger" data-smaily-engine-errors role="alert" hidden>
      <span class="smaily-banner__icon" aria-hidden="true">&#9888;</span>
      <div class="smaily-banner__body">
        <div class="smaily-banner__message" data-smaily-engine-errors-text></div>
      </div>
    </div>
    <div class="smaily-triggers">
      {% for row in card.rows %}
        {% set mode = row.mode %}
        <div class="smaily-trigger is-{{ mode }}" data-smaily-engine-trigger="{{ row.key }}"
             data-language-mode="{{ row.language_mode }}" data-original-map="{{ row.original_map|json_encode }}">
          <div class="smaily-trigger__head">
            <div class="smaily-trigger__name-row">
              <span class="smaily-trigger__name">{{ row.name }}</span>
              <span class="smaily-pill{{ mode == 'active' ? ' smaily-pill--active' : (mode == 'test' ? ' smaily-pill--pending' : '') }}" data-smaily-engine-pill><span class="smaily-pill__dot"></span><span data-smaily-engine-pill-text>{{ mode == 'active' ? 'Active'|trans : (mode == 'test' ? 'Test mode'|trans : 'Off'|trans) }}</span></span>
            </div>
            <div class="smaily-trigger__desc">{{ row.description }}</div>
            <div class="smaily-engine-switches">
              <label class="smaily-trigger__enable"><input type="checkbox" data-smaily-engine-field="{{ row.key }}.enabled"{{ row.enabled ? ' checked' : '' }}> {{ 'Enabled'|trans }}</label>
            </div>
          </div>
          <div class="smaily-trigger__settings" data-smaily-engine-settings{% if not row.enabled %} hidden{% endif %}>
            {% if row.setup is not null %}
              <div class="smaily-test-mode" data-smaily-test-mode
                   data-confirm="{{ '“%name%” will start going to your store\'s real customers, at first up to 10 emails a day, then 25 and 50.'|trans({'%name%': row.name}) }}">
                <label class="smaily-trigger__enable"><input type="checkbox" data-smaily-test-mode-switch{{ row.setup.test_mode ? ' checked' : '' }}> {{ 'Test mode'|trans }}</label>
                <p class="smaily-test-mode__status" data-smaily-test-mode-status{% if row.setup.status == '' %} hidden{% endif %}>{{ row.setup.status }}</p>
                <p class="smaily-note" data-smaily-test-mode-notice{% if row.setup.notice == '' %} hidden{% endif %}>{{ row.setup.notice }}</p>
                <div class="smaily-test-mode__test" data-smaily-test-mode-test{% if not row.setup.test_mode %} hidden{% endif %}>
                  <p class="smaily-note">{{ 'The email goes to test addresses only.'|trans }}</p>
                  <div class="smaily-trigger__ctrl">
                    <span>{{ 'Send a test email to'|trans }}</span>
                    <div class="smaily-test-mode__send">
                      <input type="email" class="form-control smaily-engine-emails" data-smaily-test-send-address value="{{ admin_email }}" aria-label="{{ 'Send a test email to'|trans }}">
                      <button type="button" class="btn btn-outline-secondary" data-smaily-action="send-test-email">{{ 'Send test email'|trans }}</button>
                    </div>
                  </div>
                  <p class="smaily-note">{{ 'This address is added to the Smaily list as a test contact.'|trans }}</p>
                </div>
                <div class="smaily-test-mode__result" data-smaily-test-mode-result role="status" hidden></div>
              </div>
            {% endif %}
            <div class="smaily-trigger__controls">
              <label class="smaily-trigger__ctrl">
                <span>{{ 'Smaily Workflow'|trans }}</span>
                <select class="form-control" data-smaily-engine-field="{{ row.key }}.workflow_id">
                  <option value="">{{ '-- Not Selected --'|trans }}</option>
                  {% for workflow in card.workflows %}
                    <option value="{{ workflow.id }}"{{ workflow.id ~ '' == row.workflow_id ? ' selected' : '' }}>{{ workflow.name }}</option>
                  {% endfor %}
                  {# A stored workflow that the Smaily list does not offer stays visible, and the save keeps it. #}
                  {% if row.workflow_id != '' and row.workflow_id not in offered %}
                    <option value="{{ row.workflow_id }}" selected>{{ 'Workflow #%id% (not in your Smaily list — kept)'|trans({'%id%': row.workflow_id}) }}</option>
                  {% endif %}
                </select>
              </label>
              <label class="smaily-trigger__ctrl">
                <span>{{ 'Cooldown (days)'|trans }}</span>
                <input type="number" class="form-control smaily-trigger__delay" data-smaily-engine-field="{{ row.key }}.cooldown_days" min="1" max="365" value="{{ row.cooldown_days }}">
              </label>
              <label class="smaily-trigger__ctrl">
                <span>{{ 'Daily Cap'|trans }}</span>
                <input type="number" class="form-control smaily-engine-cap" data-smaily-engine-field="{{ row.key }}.daily_cap" min="1" max="100000" value="{{ row.daily_cap }}" placeholder="{{ 'No cap'|trans }}">
              </label>
              <label class="smaily-trigger__ctrl">
                <span>{{ 'Test Emails'|trans }}</span>
                <input type="text" class="form-control smaily-engine-emails" data-smaily-engine-field="{{ row.key }}.test_emails" value="{{ row.test_emails }}" placeholder="a@example.com, b@example.com">
              </label>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="smaily-tab-footer">
      <button type="button" class="btn smaily-btn-primary" data-smaily-action="save-engine-automations">{{ 'Save Intelligence Automations'|trans }}</button>
      <span class="smaily-result" data-smaily-engine-result role="status"></span>
    </div>
    <div class="smaily-dialog" data-smaily-test-mode-dialog hidden>
      <div class="smaily-dialog__box" role="alertdialog" aria-modal="true" aria-labelledby="smaily-test-mode-dialog-title" aria-describedby="smaily-test-mode-dialog-message">
        <h2 class="smaily-dialog__title" id="smaily-test-mode-dialog-title">{{ 'Turn off test mode?'|trans }}</h2>
        <p class="smaily-dialog__message" id="smaily-test-mode-dialog-message" data-smaily-test-mode-dialog-message></p>
        <div class="smaily-dialog__actions">
          <button type="button" class="btn btn-outline-secondary" data-smaily-test-mode-dialog-cancel>{{ 'Cancel'|trans({}, 'Admin.Actions') }}</button>
          <button type="button" class="btn smaily-btn-primary" data-smaily-test-mode-dialog-confirm>{{ 'Turn off'|trans }}</button>
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}
