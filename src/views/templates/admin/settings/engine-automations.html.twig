{#
 # Settings > Automations: the card "Campaign Intelligence Automations" under the store automations
 # and their Save, with its own Save (Magento's config/engine-automations.phtml). The card is not
 # part of the Initial setup, and the switch "Use its own automations on this shop" does not cover
 # it: the automations belong to the Campaign Intelligence connection.
 #
 # This is the card's frame. Its content comes from Campaign Intelligence once the tab shows
 # (Admin\Api\Settings\EngineAutomationsCard, settings/engine-automations-card.html.twig), and
 # views/js/admin/engine-automations.js loads and saves it.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
<div class="smaily-panel smaily-engine-automations" data-smaily-engine-automations
     data-api-load="{{ path('smailyforprestashop_api_settings_engine_automations') }}"
     data-api-save="{{ path('smailyforprestashop_api_settings_engine_automations_save') }}"
     data-label-saving="{{ 'Saving…'|trans }}"
     data-label-saving-failed="{{ 'Saving failed.'|trans }}">
  <div class="smaily-card">
    <h2>{{ 'Campaign Intelligence Automations'|trans }}</h2>
    <div data-smaily-engine-body aria-live="polite">
      <p class="smaily-note">{{ 'Loading…'|trans }}</p>
    </div>
  </div>
</div>
