{#
 # The first contact import (Magento's "Initial contact import" card): Start import, Cancel import
 # and one progress line, from Contacts\Import\ContactImport. It is offered once the Contacts
 # settings are saved and only in a mode that imports anyone; views/js/admin/setup.js draws the
 # state from `data-import` and polls the progress while the import is queued or running.
 #
 # Takes `contacts` (ContactsPanel::values()) and `import` (ContactImport::progress(), or null).
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% set imports_anyone = contacts.mode != 'checkout_optin' %}
<div class="smaily-card smaily-import" data-smaily-import="{{ import is null ? 'null' : import|json_encode }}">
  <div class="smaily-import__head">
    <strong class="smaily-import__title">{{ 'Initial contact import'|trans }}</strong>
    <span class="smaily-pill" data-smaily-import-pill hidden><span class="smaily-pill__dot" aria-hidden="true"></span><span data-smaily-import-pill-text></span></span>
  </div>
  <p class="smaily-note" data-smaily-import-unsaved{% if contacts.active %} hidden{% endif %}>{{ 'Contacts start syncing to Smaily once the Contacts settings are saved, so an import would send nothing yet. Save them to import.'|trans }}</p>
  <p class="smaily-note" data-smaily-import-nobody{% if not contacts.active or imports_anyone %} hidden{% endif %}>{{ 'Checkout opt-in only syncs nobody automatically, so there is nothing to import.'|trans }}</p>
  <div data-smaily-import-body{% if not contacts.active or not imports_anyone %} hidden{% endif %}>
    <p class="smaily-note">{{ 'The import sends the contacts that your Contacts settings sync. It runs in the background, a chunk per minute, and never slows the storefront down.'|trans }}</p>
    <div class="smaily-progress" data-smaily-import-bar hidden><div class="smaily-progress__fill"></div></div>
    <p class="smaily-import__line" data-smaily-import-line role="status"></p>
    <div class="smaily-actions">
      <button type="button" class="btn smaily-btn-primary" data-smaily-action="import-start">{{ 'Start import'|trans }}</button>
      <button type="button" class="btn btn-outline-secondary" data-smaily-action="import-stop" hidden>{{ 'Cancel import'|trans }}</button>
      <span class="smaily-result" data-smaily-import-result role="status"></span>
    </div>
  </div>
</div>
