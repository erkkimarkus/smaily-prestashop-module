{#
 # The first contact import (Magento's "Initial contact import" card): the state pill, the bar
 # with "X of Y" and the percentage under it, the estimate (how many contacts the import sends in
 # each consent mode, ContactImport::estimate(); panels.js swaps it as the mode changes), the
 # outcome line with its icon and finish time, Start import or Run again, and Cancel import, from
 # Contacts\Import\ContactImport. views/js/admin/panels.js draws the state from
 # `data-smaily-import`, in the card's own words (data-label-*), and polls the progress while the
 # import is queued or running. While the Contacts settings are not saved, or in a mode that
 # imports nobody, the card says so and keeps Start import, disabled. A queued or running import
 # that nothing has moved for an hour is stalled: Run again starts a fresh one. A stopped import
 # names its stored reason code for a developer, never a remote text. A finished import whose
 # contacts Smaily refused says so and links the Log, whose Details list them.
 #
 # Takes `contacts` (ContactsPanel::values()), `import` (ContactImport::progress(), or null),
 # `estimate` (ContactImport::estimate() of the scope) and `all_shops` (not empty where the import
 # runs for every shop).
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% set imports_anyone = contacts.mode != 'checkout_optin' %}
{% set estimates = {} %}
{% for mode, count in estimate|default({}) %}
  {% if all_shops|default([]) is not empty %}
    {% set sentence = count == 1
      ? 'This import sends %count% contact from all shops. It runs in the background, a chunk per minute, and never slows the storefront down.'|trans({'%count%': count})
      : 'This import sends %count% contacts from all shops. It runs in the background, a chunk per minute, and never slows the storefront down.'|trans({'%count%': count}) %}
  {% else %}
    {% set sentence = count == 1
      ? 'This import sends %count% contact from this shop. It runs in the background, a chunk per minute, and never slows the storefront down.'|trans({'%count%': count})
      : 'This import sends %count% contacts from this shop. It runs in the background, a chunk per minute, and never slows the storefront down.'|trans({'%count%': count}) %}
  {% endif %}
  {% set estimates = estimates|merge({(mode): sentence}) %}
{% endfor %}
<div class="smaily-card smaily-import" data-smaily-import="{{ import is null ? 'null' : import|json_encode }}"
     data-smaily-import-estimates="{{ estimates|json_encode }}"
     data-label-queued="{{ 'Queued — the import starts on the next scheduled run…'|trans }}"
     data-label-importing="{{ 'Importing…'|trans }}"
     data-label-progress="{{ '%sent% of %total%'|trans }}"
     data-label-done="{{ 'Done, %sent% of %total% synced.'|trans }}"
     data-label-done-failed="{{ 'Done, %sent% of %total% synced — %failed% failed.'|trans }}"
     data-label-done-refused="{{ 'Done, %sent% of %total% synced. Smaily refused %failed% contacts, so they were not imported. Fix them and run the import again.'|trans }}"
     data-label-cancelled="{{ 'Canceled — %sent% of %total% synced. Starting again begins a fresh import.'|trans }}"
     data-label-stopped="{{ 'Stopped before an error — %sent% of %total% synced so far. Press Run again to run it again.'|trans }}"
     data-label-stalled="{{ 'Stalled — nothing has moved this import for over an hour; %sent% of %total% synced so far. Press Run again to start a fresh import. If it stalls again, check that the background tasks run.'|trans }}"
     data-label-details="{{ 'Details for your developer: %details%'|trans }}"
     data-label-sync-off="{{ 'Contact synchronization is off for this shop, so an import would send nothing. Turn it on and save to import.'|trans }}"
     data-label-canceling="{{ 'Canceling…'|trans }}"
     data-label-start="{{ 'Start import'|trans }}"
     data-label-run-again="{{ 'Run again'|trans }}"
     data-label-state-pending="{{ 'Pending'|trans }}"
     data-label-state-running="{{ 'Running'|trans }}"
     data-label-state-done="{{ 'Done'|trans }}"
     data-label-state-stopped="{{ 'Stopped'|trans }}"
     data-label-state-stalled="{{ 'Stalled'|trans }}"
     data-label-state-cancelled="{{ 'Canceled'|trans }}">
  <div class="smaily-import__head">
    <strong class="smaily-import__title">{{ 'Initial contact import'|trans }}</strong>
    <span class="smaily-pill" data-smaily-import-pill hidden><span class="smaily-pill__dot" aria-hidden="true"></span><span data-smaily-import-pill-text></span></span>
  </div>
  <div class="smaily-import__progress" data-smaily-import-progress hidden>
    <div class="smaily-progress"><div class="smaily-progress__fill"></div></div>
    <div class="smaily-import__count"><span data-smaily-import-count></span><span class="smaily-import__pct" data-smaily-import-pct></span></div>
  </div>
  <p class="smaily-note" data-smaily-import-estimate{% if not contacts.active or not imports_anyone %} hidden{% endif %}>{{ estimates[contacts.mode]|default('') }}</p>
  <p class="smaily-note" data-smaily-import-unsaved{% if contacts.active %} hidden{% endif %}>{{ 'Contacts start syncing to Smaily once the Contacts settings are saved, so an import would send nothing yet. Save them to import.'|trans }}</p>
  <p class="smaily-note" data-smaily-import-nobody{% if not contacts.active or imports_anyone %} hidden{% endif %}>{{ 'Checkout opt-in only syncs nobody automatically, so there is nothing to import.'|trans }}</p>
  <div class="smaily-import__verdict" data-smaily-import-verdict><span class="smaily-import__icon" data-smaily-import-icon aria-hidden="true" hidden></span><span data-smaily-import-line role="status"></span></div>
  <p class="smaily-import__line" data-smaily-import-log hidden><a href="{{ path('smailyforprestashop_log') }}">{{ 'View them in the Log'|trans }}</a></p>
  <div class="smaily-actions">
    <button type="button" class="btn smaily-btn-primary" data-smaily-action="import-start"{% if not contacts.active or not imports_anyone %} disabled{% endif %}>{{ 'Start import'|trans }}</button>
    <button type="button" class="btn btn-outline-secondary" data-smaily-action="import-stop" hidden>{{ 'Cancel import'|trans }}</button>
    <span class="smaily-result" data-smaily-import-result role="status"></span>
  </div>
</div>
