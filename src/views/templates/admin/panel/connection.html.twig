{#
 # The Connection panel: shared by the Initial setup (step 1) and Settings > Connection, read and
 # saved by Admin\Setup\ConnectionPanel. Magento's panel/connection.phtml, with "store view" read as
 # "language".
 #
 # With two or more languages, the language-mode cards come first; mode `a` swaps the one account
 # for an account per language and the default fallback account. A store with one language sees
 # none of it. The stored password is never drawn: the field stays empty and a note says that one
 # is saved.
 #
 # A save that puts another Smaily account (another subdomain) in a stored one's place asks first
 # while an automation has a workflow picked (data-label-account-change, panels.js).
 #
 # Takes `connection` (ConnectionPanel::values()), `languages` (ISO code => name), `language_modes`
 # (the modes offered) and `account_per_language_elsewhere` (mode `a` is set per shop in Settings).
 # Behaviour: views/js/admin/panels.js ([data-smaily-panel=connection]).
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% set mode = connection.language_mode %}
{% set multilingual = languages|length > 1 %}
{% set cards = {
  single: ['Single language'|trans, 'Treat every language the same: one Smaily account and one workflow per automation.'|trans],
  a: ['Per-language Smaily accounts'|trans, 'Each language has its own Smaily account (subdomain and credentials) with its own contact list.'|trans],
  b: ['One account, per-language workflows'|trans, 'A single Smaily account, but each language triggers its own automation workflow. The most common setup.'|trans],
  c: ['One workflow branching by language'|trans, 'A single workflow that branches on the contact\'s language inside Smaily. The language is sent with every contact.'|trans],
} %}
<div class="smaily-panel" data-smaily-panel="connection" data-language-mode="{{ mode }}"
     data-label-account-change="{{ 'Another Smaily account: %account%. Automations whose workflow this account does not have lose that workflow and send nothing until you pick a new one.'|trans }}"
     data-label-continue="{{ 'Continue?'|trans }}"
     data-label-mode-switch="{{ 'Switching the multilingual mode changes how contacts and automations are routed. Per-language accounts and workflow mappings that no longer apply stop being used (per-language credentials are removed on save). Continue?'|trans }}">
  {% if multilingual %}
    <div class="smaily-card" data-smaily-language-modes>
      <h2>{{ 'How is Smaily organized for your store languages?'|trans }}</h2>
      <p>{{ 'Your store speaks %count% languages (%languages%). Pick how contacts and automations should route between them — the sections below adapt right away.'|trans({'%count%': languages|length, '%languages%': languages|keys|join(', ')|upper}) }}</p>
      <div role="radiogroup" data-smaily-field="language_mode">
        {% for value, card in cards %}
          {% if value in language_modes %}
            <label class="smaily-choice{{ value == mode ? ' is-selected' : '' }}">
              <input class="smaily-choice__input" type="radio" name="smaily-language-mode" value="{{ value }}"{{ value == mode ? ' checked' : '' }}>
              <span class="smaily-choice__radio" aria-hidden="true"></span>
              <span class="smaily-choice__body">
                <span class="smaily-choice__title-row">
                  <span class="smaily-choice__title">{{ card[0] }}</span>
                  {% if value == 'b' %}<span class="smaily-choice__badge">{{ 'Most common'|trans }}</span>{% endif %}
                </span>
                <span class="smaily-choice__desc">{{ card[1] }}</span>
              </span>
            </label>
          {% endif %}
        {% endfor %}
      </div>
      {% if account_per_language_elsewhere|default(false) %}
        <p class="smaily-note">{{ 'Per-language Smaily accounts are set for one shop: under Settings > Connection, pick the shop and tick Use its own Smaily account on this shop.'|trans }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="smaily-card" data-smaily-account-block="" data-has-password="{{ connection.has_password ? 1 : 0 }}"{% if mode == 'a' %} hidden{% endif %}>
    <h2>{{ 'Smaily API credentials'|trans }}</h2>
    <div class="smaily-fields">
      <div class="smaily-field">
        <label for="smaily-subdomain">{{ 'Subdomain'|trans }}</label>
        <div class="smaily-subdomain-row">
          <input type="text" class="form-control" id="smaily-subdomain" data-smaily-field="subdomain" value="{{ connection.subdomain }}" placeholder="demo" autocomplete="off" spellcheck="false">
          <span class="smaily-subdomain-suffix">.sendsmaily.net</span>
        </div>
        <p class="smaily-note">{{ 'If your Smaily URL is https://demo.sendsmaily.net, the subdomain is "demo". Pasting the full URL also works.'|trans }}</p>
      </div>
      <div class="smaily-field">
        <label for="smaily-username">{{ 'API username'|trans }}</label>
        <input type="text" class="form-control" id="smaily-username" data-smaily-field="username" value="{{ connection.username }}" autocomplete="off" spellcheck="false">
      </div>
      <div class="smaily-field">
        <label for="smaily-password">{{ 'API password'|trans }}</label>
        <input type="password" class="form-control" id="smaily-password" data-smaily-field="password" value="" autocomplete="new-password">
        {% if connection.has_password %}
          <p class="smaily-note">{{ 'A password is already saved — leave this empty to keep it.'|trans }}</p>
        {% endif %}
      </div>
    </div>
    <div class="smaily-actions">
      <button type="button" class="btn btn-outline-secondary" data-smaily-action="test-smaily">{{ 'Test connection'|trans }}</button>
      <span class="smaily-result" data-smaily-test-result role="status"></span>
    </div>
    <div class="smaily-connection-status" data-smaily-connection-status hidden>
      <span class="smaily-connection-status__label">{{ 'Status'|trans }}:</span>
      <span class="smaily-pill" data-smaily-pill><span class="smaily-pill__dot" aria-hidden="true"></span><span data-smaily-pill-text></span></span>
    </div>
  </div>

  {% if 'a' in language_modes %}
    <div class="smaily-panel" data-smaily-per-language{% if mode != 'a' %} hidden{% endif %}>
      <div class="smaily-ml-region">
        <div class="smaily-ml-region__kicker">{{ 'Per-language Smaily accounts'|trans }}</div>
        <div class="smaily-ml-accounts">
          {% for iso, name in languages %}
            {% set own = connection.accounts[iso] %}
            <div class="smaily-ml-account" data-smaily-account-block="{{ iso }}" data-has-password="{{ own.has_password ? 1 : 0 }}">
              <div class="smaily-ml-account__head">
                <span class="smaily-ml-account__chip">{{ iso|upper }}</span>
                <h2 class="smaily-ml-account__name">{{ 'Smaily account for %language%'|trans({'%language%': name}) }}</h2>
              </div>
              <p class="smaily-note">{{ 'Contacts in the %language% language sync to this account, and their automations start from it.'|trans({'%language%': iso|upper}) }}</p>
              <div class="smaily-field">
                <label for="smaily-subdomain-{{ iso }}">{{ 'Subdomain'|trans }}</label>
                <input type="text" class="form-control" id="smaily-subdomain-{{ iso }}" data-smaily-field="accounts.{{ iso }}.subdomain" value="{{ own.subdomain }}" autocomplete="off" spellcheck="false">
              </div>
              <div class="smaily-field">
                <label for="smaily-username-{{ iso }}">{{ 'API username'|trans }}</label>
                <input type="text" class="form-control" id="smaily-username-{{ iso }}" data-smaily-field="accounts.{{ iso }}.username" value="{{ own.username }}" autocomplete="off" spellcheck="false">
              </div>
              <div class="smaily-field">
                <label for="smaily-password-{{ iso }}">{{ 'API password'|trans }}</label>
                <input type="password" class="form-control" id="smaily-password-{{ iso }}" data-smaily-field="accounts.{{ iso }}.password" value="" autocomplete="new-password">
                {% if own.has_password %}
                  <p class="smaily-note">{{ 'A password is already saved — leave this empty to keep it.'|trans }}</p>
                {% endif %}
              </div>
              <div class="smaily-actions">
                <button type="button" class="btn btn-outline-secondary" data-smaily-action="test-smaily">{{ 'Test connection'|trans }}</button>
                <span class="smaily-result" data-smaily-test-result role="status"></span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="smaily-card">
        <h2>{{ 'Default fallback account'|trans }}</h2>
        <p class="smaily-note">{{ 'Used when a contact\'s language cannot be matched to any account. Its credentials also serve every scope without a per-language override.'|trans }}</p>
        <div data-smaily-field="fallback_language">
          {% for iso, name in languages %}
            <div class="smaily-inline-toggle">
              <label>
                <input type="radio" name="smaily-fallback-language" value="{{ iso }}"{{ iso == connection.fallback_language ? ' checked' : '' }}>
                {{ 'The %language% account'|trans({'%language%': iso|upper}) }}
              </label>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</div>
