{#
 # The Automations panel: shared by the Initial setup (step 3) and Settings > Automations, read and
 # saved by Admin\Setup\AutomationsPanel. Magento's panel/automations.phtml, with "store view" read
 # as "language".
 #
 # Each store automation is a card: its name, the Off/Active pill, its description and the Enabled
 # switch; while it is on, also its Smaily workflow, for the abandoned cart the wait, and its
 # discount code (Magento's "Send a discount code" block: the switch, the cart rule that the codes
 # are copies of and the days a code is valid; the picker's list comes from Admin\Api\DiscountRules). A
 # switched-off card keeps its values in the form, so the save keeps them. The workflow lists come
 # live from Smaily (Admin\Api\Workflows): a select is empty until its list has answered, and
 # `data-saved` holds what it posts until then. `data-smaily-workflows` names the account whose
 # list a select takes: `default`, or in mode `a` its language.
 #
 # In mode `b` (one account, per-language automations) each card holds, in place of its one
 # workflow, a row per language with its workflow and the default-fallback radio on one of the
 # rows, as WooCommerce's and Shopify's cards (owner, 2026-11-26; Linear CON-460): no workflow of
 # no language and no "None" row. AutomationsPanel::values() puts the radio on the stored fallback,
 # else where the stored workflow of no language keeps serving (it shows on that row), else on the
 # first language with a workflow.
 #
 # In mode `a` the card "Per-language workflows" follows, as Magento draws it: one table per
 # automation that is on, with a workflow per language and the default fallback. The cards' own
 # workflow is not drawn: it belongs to no language's account.
 #
 # In both, Magento's warning "Some languages have no workflow" names the languages whose contacts
 # get none (panels.js reads the rows as the Router does, with `data-account-fallback`).
 #
 # A discount block whose picker lists no cart rule says so with Magento's link "Add a cart price
 # rule", which opens PrestaShop's new cart rule page (`automations.cart_rule_url`).
 #
 # An automation that is on and has no workflow picked shows "No workflow" in place of "Active".
 # Above the cards, the banner "Some automations have no workflow" names the automations whose
 # workflow a change of the Smaily account or of the language mode removed (`automations.lost`,
 # Automation\LostWorkflows); on Settings, panels.js also shows it after a Connection save.
 #
 # Takes `automations` (AutomationsPanel::values()), `languages` (ISO code => name) and `context`
 # ('setup' or 'settings': the Initial setup shows the title above the step).
 # Behaviour: views/js/admin/panels.js ([data-smaily-panel=automations]).
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% set mode = automations.mode %}
{% set per_language = mode in ['a', 'b'] %}
{% set unmapped_banner %}
  <div class="smaily-banner" role="status" data-smaily-unmapped hidden>
    <span class="smaily-banner__icon" aria-hidden="true">&#9888;</span>
    <div class="smaily-banner__body">
      <div class="smaily-banner__title">{{ 'Some languages have no workflow'|trans }}</div>
      <div class="smaily-banner__message">{{ 'Contacts in these languages get no automation. Pick a workflow for them, or a default fallback.'|trans }}</div>
      <ul class="smaily-banner__message" data-smaily-unmapped-list></ul>
    </div>
  </div>
{% endset %}
{% set triggers = {
  welcome: ['Welcome'|trans, 'Fires when a shopper subscribes to the newsletter in your store.'|trans],
  first_order: ['First order'|trans, 'Fires on a customer\'s first purchase.'|trans],
  abandoned_cart: ['Abandoned cart'|trans, 'Fires when a cart is left behind.'|trans],
} %}
{% set any_on = automations.triggers|filter(saved => saved.enabled)|length > 0 %}
{% set lost_names = automations.lost|map(entry => triggers[entry.trigger][0] ~ (entry.language != '' ? ' (' ~ entry.language|upper ~ ')' : ''))|join(', ') %}
<div class="smaily-panel" data-smaily-panel="automations" data-mode="{{ mode }}" data-account-fallback="{{ automations.account_fallback }}"
     data-label-active="{{ 'Active'|trans }}"
     data-label-no-workflow="{{ 'No workflow'|trans }}"
     data-label-off="{{ 'Off'|trans }}"
     data-label-not-selected="{{ '-- Not Selected --'|trans }}"
     data-label-kept="{{ 'Workflow #%id% (not in your Smaily list — kept)'|trans }}"
     data-label-optin="{{ 'Smaily\'s opt-in trigger (from 2.x)'|trans }}"
     data-label-pick-rule="{{ 'Pick a rule'|trans }}">
  <div class="smaily-banner" role="status" data-smaily-lost-workflows{% if automations.lost is empty %} hidden{% endif %}
       data-label-message="{{ 'The Smaily account or the multilingual mode changed, so these automations lost a workflow that is not in the account\'s list: %automations%. They send nothing until you pick a workflow below and save.'|trans }}">
    <span class="smaily-banner__icon" aria-hidden="true">&#9888;</span>
    <div class="smaily-banner__body">
      <div class="smaily-banner__title">{{ 'Some automations have no workflow'|trans }}</div>
      <div class="smaily-banner__message" data-smaily-lost-message>{{ 'The Smaily account or the multilingual mode changed, so these automations lost a workflow that is not in the account\'s list: %automations%. They send nothing until you pick a workflow below and save.'|trans({'%automations%': lost_names}) }}</div>
    </div>
  </div>
  <div class="smaily-card">
    {% if context|default('setup') == 'settings' %}
      <h2>{{ 'Map store events to Smaily automations'|trans }}</h2>
    {% endif %}
    <p>
      {{ 'Each event triggers the Smaily automation workflow you pick. The lists below come live from your Smaily account — create the workflows there first if they are missing, then press Refresh.'|trans }}
      <button type="button" class="btn btn-link smaily-triggers__refresh" data-smaily-action="refresh-workflows">{{ 'Refresh workflows'|trans }}</button>
    </p>
    {% if mode == 'b' %}
      <p class="smaily-note">{{ 'Pick a workflow for each language. The default fallback handles contacts whose language has no workflow.'|trans }}</p>
      {{ unmapped_banner }}
    {% endif %}

    <div class="smaily-triggers">
      {% for trigger, card in triggers %}
        {% set saved = automations.triggers[trigger] %}
        {% set has_workflow = (not per_language and saved.workflow != '') or saved.languages|filter(workflow => workflow != '')|length > 0 %}
        <div class="smaily-trigger{{ saved.enabled ? ' is-active' : ' is-off' }}" data-smaily-trigger="{{ trigger }}">
          <div class="smaily-trigger__head">
            <div class="smaily-trigger__name-row">
              <span class="smaily-trigger__name">{{ card[0] }}</span>
              <span class="smaily-pill{{ saved.enabled ? (has_workflow ? ' smaily-pill--active' : ' smaily-pill--pending') : '' }}" data-smaily-pill><span class="smaily-pill__dot"></span><span data-smaily-pill-text>{{ saved.enabled ? (has_workflow ? 'Active'|trans : 'No workflow'|trans) : 'Off'|trans }}</span></span>
            </div>
            <div class="smaily-trigger__desc">{{ card[1] }}</div>
            <label class="smaily-trigger__enable"><input type="checkbox" data-smaily-field="{{ trigger }}.enabled"{{ saved.enabled ? ' checked' : '' }}> {{ 'Enabled'|trans }}</label>
          </div>
          <div class="smaily-trigger__settings" data-smaily-trigger-settings{% if not saved.enabled %} hidden{% endif %}>
            {% if mode == 'b' %}
              <table class="smaily-ml-table" data-smaily-language-trigger="{{ trigger }}">
                <thead>
                  <tr>
                    <th>{{ 'Language'|trans }}</th>
                    <th>{{ 'Workflow'|trans }}</th>
                    <th>{{ 'Default fallback'|trans }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for iso in languages|keys %}
                    <tr>
                      <td>{{ iso|upper }}</td>
                      <td><select class="form-control" data-smaily-field="{{ trigger }}.languages.{{ iso }}" data-language="{{ iso }}" data-smaily-workflows="default" data-saved="{{ saved.languages[iso]|default('') }}" aria-label="{{ card[0] }}, {{ iso|upper }}"></select></td>
                      <td><input type="radio" name="smaily-fallback-{{ trigger }}" value="{{ iso }}"{{ saved.fallback == iso ? ' checked' : '' }} aria-label="{{ 'Default fallback'|trans }}, {{ iso|upper }}"></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% endif %}
            <div class="smaily-trigger__controls">
              {% if not per_language %}
                <label class="smaily-trigger__ctrl">
                  <span>{{ 'Smaily Workflow'|trans }}</span>
                  <select class="form-control" data-smaily-field="{{ trigger }}.workflow" data-smaily-workflows="default" data-saved="{{ saved.workflow }}"></select>
                </label>
              {% endif %}
              {% if trigger == 'abandoned_cart' %}
                <label class="smaily-trigger__ctrl">
                  <span>{{ 'Wait (minutes)'|trans }}</span>
                  <input type="number" class="form-control smaily-trigger__delay" data-smaily-field="cart_delay" min="10" max="1435" value="{{ automations.cart_delay }}">
                </label>
              {% endif %}
            </div>
            <div class="smaily-trigger__discount">
              <label class="smaily-trigger__enable"><input type="checkbox" data-smaily-field="{{ trigger }}.discount.enabled"{{ saved.discount.enabled ? ' checked' : '' }}> {{ 'Send a discount code'|trans }}</label>
              <div data-smaily-discount-body{% if not saved.discount.enabled %} hidden{% endif %}>
                <div class="smaily-trigger__controls">
                  <label class="smaily-trigger__ctrl">
                    <span>{{ 'Cart price rule'|trans }}</span>
                    <select class="form-control" data-smaily-field="{{ trigger }}.discount.rule" data-smaily-discount-rules data-saved="{{ saved.discount.rule ?: '' }}"></select>
                  </label>
                  <label class="smaily-trigger__ctrl">
                    <span>{{ 'Valid for (days)'|trans }}</span>
                    <input type="number" class="form-control smaily-trigger__delay" data-smaily-field="{{ trigger }}.discount.days" min="1" max="365" value="{{ saved.discount.days }}">
                  </label>
                </div>
                <p class="smaily-note">{{ 'The discount\'s percentage or amount, its conditions and its dates come from the cart price rule you pick. The module only makes each shopper\'s own single-use code from it.'|trans }}</p>
                <p class="smaily-note">{{ 'A code works until the end of the day that many days after the email, and never after the rule\'s own end date.'|trans }}</p>
                <p class="smaily-note">{{ 'Keep the rule itself disabled, or give it a code that you do not share, so that shoppers cannot use it directly. The codes made from it work either way.'|trans }}</p>
                <div data-smaily-discount-empty hidden>
                  <p class="smaily-note">{{ 'No cart price rule can be picked yet. Add one in Catalog > Discounts with the discount you want, then press Refresh workflows: the rule appears in the list.'|trans }}</p>
                  {% if automations.cart_rule_url %}
                    <p class="smaily-note"><a href="{{ automations.cart_rule_url }}" target="_blank" rel="noopener">{{ 'Add a cart price rule'|trans }}</a></p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <p class="smaily-note">{{ 'How long a cart must be inactive before it counts as abandoned. From 10 to 1435 minutes. Carts older than 24 hours are never mailed.'|trans }}</p>
    <p class="smaily-note">{{ 'If another tool also sends abandoned-cart emails (for example another PrestaShop module such as Customer follow-up), switch those emails off there, so a shopper does not get two reminders for one cart.'|trans }}</p>
    <p class="smaily-note">
      {{ 'The automation receives the cart contents (up to 10 products).'|trans }}
      {% if languages|length > 1 and not per_language %}
        {{ 'Want a different workflow per language? Pick a per-language mode on the Connection panel.'|trans }}
      {% endif %}
    </p>
  </div>

  {% if mode == 'a' %}
    <div class="smaily-card" data-smaily-language-workflows{% if not any_on %} hidden{% endif %}>
      <h2>{{ 'Per-language workflows'|trans }}</h2>
      <p class="smaily-note">{{ 'Each language row lists the workflows of that language\'s own Smaily account (Connection panel) and fires through it.'|trans }}</p>
      <p class="smaily-note">{{ 'The default fallback handles contacts whose language has no workflow. Leave it on "None" to use the workflow of the default fallback account\'s language (Connection panel). With neither, these contacts get no automation.'|trans }}</p>
      {{ unmapped_banner }}

      {% for trigger, card in triggers %}
        {% set saved = automations.triggers[trigger] %}
        <div class="smaily-field smaily-ml-trigger" data-smaily-language-trigger="{{ trigger }}"{% if not saved.enabled %} hidden{% endif %}>
          <label>{{ card[0] }}</label>
          <table class="smaily-ml-table">
            <thead>
              <tr>
                <th>{{ 'Language'|trans }}</th>
                <th>{{ 'Workflow'|trans }}</th>
                <th>{{ 'Default fallback'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for iso in languages|keys %}
                <tr>
                  <td>{{ iso|upper }}</td>
                  <td><select class="form-control" data-smaily-field="{{ trigger }}.languages.{{ iso }}" data-language="{{ iso }}" data-smaily-workflows="{{ iso }}" data-saved="{{ saved.languages[iso]|default('') }}" aria-label="{{ card[0] }}, {{ iso|upper }}"></select></td>
                  <td><input type="radio" name="smaily-fallback-{{ trigger }}" value="{{ iso }}"{{ saved.fallback == iso ? ' checked' : '' }} aria-label="{{ 'Default fallback'|trans }}, {{ iso|upper }}"></td>
                </tr>
              {% endfor %}
              <tr>
                <td colspan="2" class="smaily-ml-none">{{ 'None (use the default fallback account\'s language)'|trans }}</td>
                <td><input type="radio" name="smaily-fallback-{{ trigger }}" value=""{{ saved.fallback == '' ? ' checked' : '' }} aria-label="{{ 'Default fallback'|trans }}"></td>
              </tr>
            </tbody>
          </table>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
