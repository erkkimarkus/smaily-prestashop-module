{#
 # Initial setup, step 5 (Overview, "Summary and last check"): what is set, each line with an Edit
 # link back to its step, each store automation with its Active, No workflow or Off as WooCommerce's
 # step 6 lists what is active; the card on the background tasks with the store's cron line, which
 # the page asks the server for (Admin\Dashboard\CronLine, dashboard.js) and never carries, and
 # the guide's cron section; then Magento's closing card (where everything lives from now on:
 # Settings, the Log, the product RSS feed in the store's default language with the URL builder,
 # which offers the other languages, and the User Guide, Admin\UserGuide). Step 4's Continue opens
 # the page again on this step, so it shows what the steps saved; Finish ends the setup (SaveStep
 # `finish`) and opens the Dashboard, as WooCommerce's Finish (owner, 2026-11-26; Linear CON-460).
 # The connection state of each Smaily account is asked of Smaily when the step shows (setup.js).
 #
 # `smaily_setup` comes from Admin\Setup\SetupController.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% set o = smaily_setup.overview %}
{% set language_modes = {
  single: 'Single language'|trans,
  a: 'Separate Smaily accounts'|trans,
  b: 'One account, per-language automations'|trans,
  c: 'One account, one automation with branches'|trans,
} %}
{% set contact_modes = {
  subscribers: 'Subscribers only (consent)'|trans,
  all_customers: 'All customers (legitimate interest)'|trans,
  checkout_optin: 'Checkout opt-in only'|trans,
} %}
{% set field_labels = {first_name: 'First name'|trans, last_name: 'Last name'|trans, user_gender: 'Gender'|trans, birthday: 'Date of birth'|trans, customer_id: 'Customer ID'|trans, customer_group: 'Customer group'|trans, subscription_type: 'Subscription type'|trans, website: 'Website'|trans} %}
{% macro edit(step, label) %}<a href="#" class="smaily-summary__edit" data-smaily-action="setup-goto" data-step="{{ step }}">{{ label }}</a>{% endmacro %}
{% set edit_label = 'Edit'|trans %}
{% import _self as summary %}
{% set automation_names = {welcome: 'Welcome'|trans, first_order: 'First order'|trans, abandoned_cart: 'Abandoned cart'|trans} %}

<p>{{ 'Smaily Connect is configured and ready. Make sure that all settings are correct and click Finish to save.'|trans }}</p>

{% if o is not null %}
  <div class="smaily-card smaily-summary" data-smaily-overview>
    <dl class="smaily-summary__list">
      {% for account in o.accounts %}
        <div class="smaily-summary__row">
          <dt>{{ account.language == '' ? 'Smaily account'|trans : 'Smaily account for %language%'|trans({'%language%': account.name}) }}</dt>
          <dd>
            <code>{{ account.subdomain }}.sendsmaily.net</code>
            <span class="smaily-pill" data-smaily-account-state="{{ account.language }}"><span class="smaily-pill__dot" aria-hidden="true"></span><span data-smaily-pill-text>{{ 'Checking…'|trans }}</span></span>
            {% if account.fallback %}<span class="smaily-note">{{ 'Default fallback account'|trans }}</span>{% endif %}
          </dd>
          <dd class="smaily-summary__action">{{ summary.edit(1, edit_label) }}</dd>
        </div>
      {% else %}
        <div class="smaily-summary__row">
          <dt>{{ 'Smaily account'|trans }}</dt>
          <dd><span class="smaily-pill smaily-pill--off"><span class="smaily-pill__dot" aria-hidden="true"></span>{{ 'Not connected'|trans }}</span></dd>
          <dd class="smaily-summary__action">{{ summary.edit(1, edit_label) }}</dd>
        </div>
      {% endfor %}
      {% if o.shape is not null %}
        <div class="smaily-summary__row">
          <dt>{{ 'Your shops'|trans }}</dt>
          <dd>{{ o.shape == 'separate' ? 'Separate stores'|trans : 'One store in several versions'|trans }}</dd>
          <dd class="smaily-summary__action">{{ summary.edit(1, edit_label) }}</dd>
        </div>
      {% endif %}
      {% if o.language_mode is not null %}
        <div class="smaily-summary__row">
          <dt>{{ 'Languages'|trans }}</dt>
          <dd>{{ language_modes[o.language_mode] }}</dd>
          <dd class="smaily-summary__action">{{ summary.edit(1, edit_label) }}</dd>
        </div>
      {% endif %}
      <div class="smaily-summary__row">
        <dt>{{ 'Who should be synced to Smaily?'|trans }}</dt>
        <dd>{{ o.contacts.active ? contact_modes[o.contacts.mode] : 'Not saved yet: nothing syncs to Smaily.'|trans }}</dd>
        <dd class="smaily-summary__action">{{ summary.edit(2, edit_label) }}</dd>
      </div>
      <div class="smaily-summary__row">
        <dt>{{ 'Extra fields to sync with each contact'|trans }}</dt>
        <dd>
          {%- set chosen = [] -%}
          {%- for field in o.contacts.fields %}{% set chosen = chosen|merge([field_labels[field]]) %}{% endfor -%}
          {{ chosen is empty ? 'None'|trans : chosen|join(', ') }}
        </dd>
        <dd class="smaily-summary__action">{{ summary.edit(2, edit_label) }}</dd>
      </div>
      {% if o.contacts.mode == 'all_customers' %}
        <div class="smaily-summary__row">
          <dt>{{ 'Also sync guest buyers who did not tick the newsletter box'|trans }}</dt>
          <dd>{{ o.contacts.guests ? 'On'|trans : 'Off'|trans }}</dd>
          <dd class="smaily-summary__action">{{ summary.edit(2, edit_label) }}</dd>
        </div>
      {% endif %}
      <div class="smaily-summary__row">
        <dt>{{ 'Show a newsletter checkbox at checkout'|trans }}</dt>
        <dd>
          {% if o.contacts.newsletter_module %}
            {{ 'PrestaShop\'s newsletter module shows it'|trans }}
          {% else %}
            {{ o.contacts.checkout_checkbox ? 'On'|trans : 'Off'|trans }}
          {% endif %}
        </dd>
        <dd class="smaily-summary__action">{{ summary.edit(2, edit_label) }}</dd>
      </div>
      <div class="smaily-summary__row">
        <dt>{{ 'Initial contact import'|trans }}</dt>
        <dd>
          {% if o.import is null %}
            {{ 'Not started'|trans }}
          {% elseif o.import.status == 'done' %}
            {{ 'Done, %sent% of %total% synced.'|trans({'%sent%': o.import.sent, '%total%': o.import.total}) }}
          {% elseif o.import.status == 'cancelled' %}
            {{ 'Canceled — %sent% of %total% synced. Starting again begins a fresh import.'|trans({'%sent%': o.import.sent, '%total%': o.import.total}) }}
          {% elseif o.import.status == 'failed' %}
            {{ 'Stopped before an error — %sent% of %total% synced so far. Press Run again to run it again.'|trans({'%sent%': o.import.sent, '%total%': o.import.total}) }}
          {% else %}
            {{ 'Importing…'|trans }} {{ '%sent% of %total%'|trans({'%sent%': o.import.sent, '%total%': o.import.total}) }}
          {% endif %}
        </dd>
        <dd class="smaily-summary__action">{{ summary.edit(2, edit_label) }}</dd>
      </div>
      {% set a = smaily_setup.automations %}
      {% if a is not null %}
        {% for trigger, name in automation_names %}
          {% set saved = a.triggers[trigger] %}
          {% set has_workflow = (a.mode not in ['a', 'b'] and saved.workflow != '') or saved.languages|filter(workflow => workflow != '')|length > 0 %}
          <div class="smaily-summary__row">
            <dt>{{ name }}</dt>
            <dd>
              <span class="smaily-pill{{ saved.enabled ? (has_workflow ? ' smaily-pill--active' : ' smaily-pill--pending') : ' smaily-pill--off' }}"><span class="smaily-pill__dot" aria-hidden="true"></span>{{ saved.enabled ? (has_workflow ? 'Active'|trans : 'No workflow'|trans) : 'Off'|trans }}</span>
              {% if trigger == 'abandoned_cart' and saved.enabled %}<span class="smaily-note">{{ 'Wait (minutes)'|trans }}: {{ a.cart_delay }}</span>{% endif %}
            </dd>
            <dd class="smaily-summary__action">{{ summary.edit(3, edit_label) }}</dd>
          </div>
        {% endfor %}
      {% endif %}
      {% set ci = o.intelligence %}
      {% if ci is not null %}
        <div class="smaily-summary__row">
          <dt>{{ 'Campaign Intelligence'|trans }}</dt>
          <dd>
            {% if not ci.connected %}
              <span class="smaily-pill smaily-pill--off"><span class="smaily-pill__dot" aria-hidden="true"></span>{{ 'Not connected'|trans }}</span>
            {% elseif ci.state == 'connected' %}
              {{ ci.name }} <span class="smaily-pill smaily-pill--active"><span class="smaily-pill__dot" aria-hidden="true"></span>{{ 'Connected'|trans }}</span>
            {% else %}
              {{ ci.name }} <span class="smaily-pill smaily-pill--failed"><span class="smaily-pill__dot" aria-hidden="true"></span>{{ ci.state == 'not_active' ? 'Not active'|trans : 'Not connected'|trans }}</span>
            {% endif %}
          </dd>
          <dd class="smaily-summary__action">{{ summary.edit(4, edit_label) }}</dd>
        </div>
        <div class="smaily-summary__row">
          <dt>{{ 'Cookie banner'|trans }}</dt>
          <dd>{{ ci.consent ? 'On'|trans : 'Off'|trans }}</dd>
          <dd class="smaily-summary__action">{{ summary.edit(4, edit_label) }}</dd>
        </div>
        {% if ci.connected %}
          <div class="smaily-summary__row">
            <dt>{{ 'Historical imports'|trans }}</dt>
            <dd>
              {%- set lines = [] -%}
              {%- for entity, title in {catalog: 'Catalog'|trans, customers: 'Customers'|trans, orders: 'Orders'|trans} -%}
                {%- set job = ci.imports[entity] -%}
                {%- if job is null -%}
                  {%- set text = 'Not started'|trans -%}
                {%- elseif job.status == 'done' -%}
                  {%- set text = 'Done, %sent% of %total% synced.'|trans({'%sent%': job.sent, '%total%': job.total}) -%}
                {%- elseif job.status == 'running' -%}
                  {%- set text = 'Importing…'|trans ~ ' ' ~ '%sent% of %total%'|trans({'%sent%': job.sent, '%total%': job.total}) -%}
                {%- else -%}
                  {%- set text = {queued: 'Queued'|trans, cancelled: 'Canceled'|trans, stalled: 'Stalled'|trans}[job.status]|default('Stopped'|trans) -%}
                {%- endif -%}
                {%- set lines = lines|merge([title ~ ': ' ~ text]) -%}
              {%- endfor -%}
              {{ lines|join(' · ') }}
            </dd>
            <dd class="smaily-summary__action">{{ summary.edit(4, edit_label) }}</dd>
          </div>
        {% endif %}
      {% endif %}
      <div class="smaily-summary__row">
        <dt>{{ 'Background tasks last ran'|trans }}</dt>
        <dd>{{ o.last_tick is null ? 'Not yet'|trans : o.last_tick }}</dd>
        <dd class="smaily-summary__action"></dd>
      </div>
    </dl>
  </div>
{% endif %}

<div class="smaily-card smaily-summary smaily-overview-background" data-smaily-overview-background>
  <div class="smaily-card__head"><h2>{{ 'Background tasks'|trans }}</h2></div>
  <p>{{ 'Background tasks run with your shop\'s traffic. For reliable timing, add the line below to your server\'s cron.'|trans }}</p>
  {% if smaily_setup.can_configure %}
    <div data-smaily-cron-line="{{ path('smailyforprestashop_api_cron_line') }}"{% if smaily_setup_step|default(1) == 5 %} data-smaily-cron-open{% endif %}>
      <div class="smaily-cron-ask" data-smaily-cron-ask>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-smaily-action="cron-line">{{ 'Show the cron line'|trans }}</button>
        <span class="smaily-note">{{ 'Add it to your server\'s cron for reliable timing.'|trans }}</span>
      </div>
      <code class="smaily-cron" data-smaily-cron hidden></code>
      <div class="smaily-result" data-smaily-result role="status"></div>
    </div>
  {% else %}
    <p class="smaily-note">{{ 'Ask an administrator who may change the Smaily Connect settings to add the cron line.'|trans }}</p>
  {% endif %}
  <p class="smaily-note"><a href="{{ smaily_setup.cron_guide }}" target="_blank" rel="noopener noreferrer">{{ 'How to add the cron line'|trans }}</a></p>
</div>

<div class="smaily-card smaily-summary">
  <p data-smaily-overview-connected hidden>{{ 'Smaily Connect is now syncing in near-real-time. Here is where everything lives from now on:'|trans }}</p>
  <p data-smaily-overview-not-connected>{{ 'Syncing starts once Smaily accepts the credentials — check them in Settings > Connection and test the connection. Here is where everything lives from now on:'|trans }}</p>
  <ul class="smaily-overview-links">
    <li><a href="{{ path('smailyforprestashop_settings') }}">{{ 'Settings'|trans }}</a> — {{ 'every setting from the initial setup as always-available tabs, including the historical imports and the RSS feed URL builder'|trans }}</li>
    <li><a href="{{ path('smailyforprestashop_log') }}">{{ 'Log'|trans }}</a> — {{ 'every delivery to Smaily and Campaign Intelligence with retry; check here first if something seems off'|trans }}</li>
    <li>{{ 'Product RSS feed for the Smaily template editor:'|trans }} <code>{{ smaily_setup.rss_feed }}</code><br>
      <span class="smaily-note">{{ smaily_setup.languages|length > 1 ? 'Need a feed in another language, or a category-filtered or sorted feed? Use the URL builder under Settings > RSS.'|trans : 'Need a category-filtered or sorted feed? Use the URL builder under Settings > RSS.'|trans }}
        <a href="{{ path('smailyforprestashop_settings', {tab: 'rss'}) }}">{{ 'Open the URL builder'|trans }}</a></span></li>
    <li><a href="{{ smaily_setup.user_guide }}" target="_blank" rel="noopener noreferrer">{{ 'User Guide'|trans }}</a> — {{ 'the full merchant documentation: every feature, setting and troubleshooting steps'|trans }}</li>
  </ul>
</div>
{# Not .smaily-footer: common.js takes the setup's first .smaily-footer for Back and Continue. #}
<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
  <a href="#" class="btn btn-outline-secondary" data-smaily-action="setup-goto" data-step="4">{{ 'Back'|trans }}</a>
  <div class="smaily-footer__end">
    <span class="smaily-result" data-smaily-finish-result role="status"></span>
    <button type="button" class="btn smaily-btn-primary" data-smaily-action="setup-finish">{{ 'Finish'|trans }}</button>
  </div>
</div>
