{#
 # The Initial setup page: the shell's frame (layout/setup.html.twig) with the setup's endpoints and
 # words for views/js/admin/setup.js, which saves each step through Admin\Api\Setup.
 #}
{% extends '@Modules/smailyforprestashop/views/templates/admin/layout/setup.html.twig' %}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}

{% block smaily_page %}
  <div class="smaily-setup-root" data-smaily-setup-root
       data-api-save="{{ path('smailyforprestashop_api_setup_save') }}"
       data-api-test="{{ path('smailyforprestashop_api_setup_test') }}"
       data-api-workflows="{{ path('smailyforprestashop_api_setup_workflows') }}"
       data-api-import="{{ path('smailyforprestashop_api_setup_import') }}"
       data-api-import-progress="{{ path('smailyforprestashop_api_setup_import_progress') }}"
       data-setup-url="{{ path('smailyforprestashop_setup') }}"
       data-label-testing="{{ 'Testing…'|trans }}"
       data-label-connected="{{ 'Connected'|trans }}"
       data-label-connected-next="{{ 'Connected! Continue to the next step.'|trans }}"
       data-label-not-connected="{{ 'Not connected'|trans }}"
       data-label-failed="{{ 'Connection failed.'|trans }}"
       data-label-saving-failed="{{ 'Saving failed.'|trans }}"
       data-label-saving="{{ 'Saving…'|trans }}">
    {{ parent() }}
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('../modules/smailyforprestashop/views/js/admin/panels.js') }}?v={{ smaily.version }}"></script>
  <script src="{{ asset('../modules/smailyforprestashop/views/js/admin/setup.js') }}?v={{ smaily.version }}"></script>
{% endblock %}
