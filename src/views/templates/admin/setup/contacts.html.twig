{#
 # Initial setup, step 2 (Contacts): the Contacts panel, which also holds the first contact import.
 # In separate stores with "All shops" selected, the step says to pick a shop instead.
 #
 # `smaily_setup` comes from Admin\Setup\SetupController.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% if smaily_setup.contacts is null %}
  {% include '@Modules/smailyforprestashop/views/templates/admin/panel/separate-stores.html.twig' only %}
{% else %}
  {% include '@Modules/smailyforprestashop/views/templates/admin/panel/contacts.html.twig' with {
    contacts: smaily_setup.contacts,
    context: 'setup',
    all_shops: smaily_setup.all_shops,
    import: smaily_setup.import,
  } only %}
{% endif %}
