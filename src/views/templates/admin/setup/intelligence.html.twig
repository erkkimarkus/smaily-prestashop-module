{#
 # Initial setup, step 4 (Intelligence, optional): the Intelligence panel in its setup form, as
 # Magento's step: the setup link, the connected line, the notices of the imports that started and
 # the cookie-banner confirmation. The import cards, Check again and Disconnect are on Settings >
 # Intelligence. Finish saves the confirmation and ends the setup (intelligence.js).
 #
 # `smaily_setup` comes from Admin\Setup\SetupController.
 #}
{% trans_default_domain 'Modules.Smailyforprestashop.Admin' %}
{% if smaily_setup.intelligence is null %}
  <div class="smaily-panel">
    {% include '@Modules/smailyforprestashop/views/templates/admin/panel/separate-stores.html.twig' only %}
  </div>
{% else %}
  {% include '@Modules/smailyforprestashop/views/templates/admin/panel/intelligence.html.twig' with {
    intelligence: smaily_setup.intelligence,
    context: 'setup',
    shops: smaily_setup.all_shops,
  } only %}
{% endif %}
