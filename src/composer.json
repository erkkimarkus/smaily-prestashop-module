{
    "name": "smaily/smailyforprestashop",
    "version": "3.0.0",
    "description": "Smaily integration module for PrestaShop",
    "license": "GNU General Public License v3.0",
    "authors": [
        {
            "name": "Smaily"
        }
    ],
    "autoload": {
        "psr-4": {
            "PrestaShop\\Module\\SmailyForPrestaShop\\": "src/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "platform-check": false,
        "platform": {
            "php": "8.0.30"
        }
    },
    "type": "prestashop-module",
    "require-dev": {
        "prestashop/php-dev-tools": "^4.3",
        "prestashop/autoindex": "^2.1",
        "phpunit/phpunit": "^9.6",
        "symfony/http-client": "^5.4"
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run",
        "fix": "php-cs-fixer fix",
        "phpstan": "_PS_ROOT_DIR_=/var/www/html phpstan analyse .",
        "autoindex": "php vendor/bin/autoindex prestashop:add:index . --exclude=vendor",
        "header-stamp": "php vendor/bin/header-stamp --license=../bin/license-header.txt --exclude=vendor --extensions=php,html.twig,tpl --header-discrimination-string=\"NOTICE OF LICENSE\"",
        "test": "phpunit --configuration ../phpunit.xml.dist",
        "package": "sh ../bin/package.sh"
    }
}
